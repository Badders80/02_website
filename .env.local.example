# App + Firebase (client)
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_FIREBASE_CONFIG={"apiKey":"...","authDomain":"evolution-engine.firebaseapp.com","projectId":"evolution-engine",...}

# Stripe (redirect flows only; publishable key is doc remnant, not loaded client-side)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
# Use split secrets for separate Stripe webhook endpoints (recommended for prod):
#   /api/kyc/callback -> STRIPE_KYC_WEBHOOK_SECRET (events: identity.verification_session.*)
#   /api/checkout/webhook -> STRIPE_CHECKOUT_WEBHOOK_SECRET (events: checkout.session.*)
# Fallback to single STRIPE_WEBHOOK_SECRET supported for backward compat.
STRIPE_KYC_WEBHOOK_SECRET=whsec_...
STRIPE_CHECKOUT_WEBHOOK_SECRET=whsec_...
STRIPE_WEBHOOK_SECRET=whsec_...  # fallback only

# For KYC claims in webhooks (get from GCP IAM service account json with Firebase Auth Admin)
FIREBASE_SERVICE_ACCOUNT_KEY='{"type":"service_account", "project_id":"evolution-engine", ... full json ...}'

# Optional: for holdings write from checkout webhook
GOOGLE_SHEETS_WEB_APP_URL=https://script.google.com/macros/s/.../exec

# PostHog
NEXT_PUBLIC_POSTHOG_KEY=phc_xxx
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
POSTHOG_PERSONAL_API_KEY=phx_xxx
POSTHOG_PROJECT_ID=xxxxx

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...  # server-only, never exposed to client

# Dual-write phase (set to 'true' to write to both Sheets + Supabase)
DUAL_WRITE_ENABLED=false
